            "entityType": { "type": "EntityType", "required": false },
            "entityId": { "type": "string", "required": false }
          }
        },
        {
          "path": "/notifications/mark-as-read",
          "method": "POST",
          "authRequired": true,
          "description": "Mark list of notification IDs as read.",
