            "limit": { "type": "number | string", "required": false }
          }
        },
        {
          "path": "/notifications/unread-summary",
          "method": "GET",
          "authRequired": true,
          "description": "Get quick count of unread notifications."
        },
        {
          "path": "/notifications",
          "method": "POST",
          "authRequired": true,
          "allowedRoles": ["ADMIN"],
          "description": "Create a new notification (Admin only).",
