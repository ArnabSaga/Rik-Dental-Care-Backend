          "params": {
            "id": { "type": "string", "required": true }
          },
          "body": {
            "content": { "type": "string", "required": true, "min": 1, "max": 3000 },
            "recipientId": { "type": "string", "required": false }
          }
        },
        {
          "path": "/chat/messages/:id/read",
          "method": "PATCH",
          "authRequired": true,
          "description": "Mark a message as read.",
