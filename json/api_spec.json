          }
        },
        {
          "path": "/chat/messages/:id",
          "method": "DELETE",
          "authRequired": true,
          "description": "Delete specific message.",
          "params": {
            "id": { "type": "string", "required": true }
          }
        },
        {
          "path": "/chat/ai",
          "method": "POST",
          "authRequired": true,
          "description": "Chat with the AI Dental Care Assistant. Responds instantly based on dental knowledge base.",
          "body": {
            "message": { "type": "string", "required": true, "min": 1, "max": 3000 },
            "conversationId": { "type": "string", "required": false }
          }
        }
      ]
    },
