    "invoices": {
      "description": "Billing, invoice items, totals, payments tracking, and EJS PDF generation.",
      "routes": [
        {
          "path": "/invoices",
          "method": "GET",
          "authRequired": true,
          "description": "Get list of billing invoices.",
          "query": {
            "searchTerm": { "type": "string", "required": false },
            "appointmentId": { "type": "string", "required": false },
            "status": { "type": "InvoiceStatus", "required": false },
            "patientId": { "type": "string", "required": false },
            "page": { "type": "number | string", "required": false },
            "limit": { "type": "number | string", "required": false }
          }
        },
        {
          "path": "/invoices",
          "method": "POST",
          "authRequired": true,
          "allowedRoles": ["ADMIN"],
          "contentType": "multipart/form-data",
          "description": "Create new billing invoice. Supports uploading attachmentFile.",
          "body": {
            "appointmentId": { "type": "string", "required": true },
            "dueDate": { "type": "string | Date", "required": false, "nullable": true },
            "discountAmount": { "type": "number", "required": false, "default": 0 },
            "taxAmount": { "type": "number", "required": false, "default": 0 },
            "status": { "type": "InvoiceStatus", "required": false, "default": "DRAFT" },
            "pdfUrl": { "type": "string (url)", "required": false, "nullable": true },
            "attachmentFile": { "type": "file", "required": false },
            "items": {
              "type": "array of objects",
              "required": false,
              "items": {
                "serviceId": { "type": "string", "required": false, "nullable": true },
                "serviceName": { "type": "string", "required": true, "max": 150 },
                "description": { "type": "string", "required": false, "max": 1000, "nullable": true },
                "quantity": { "type": "number", "required": false, "default": 1 },
                "unitPrice": { "type": "number", "required": true },
                "discountAmount": { "type": "number", "required": false, "default": 0 }
              }
            }
          }
        },
        {
          "path": "/invoices/preview/:id",
          "method": "GET",
          "authRequired": true,
          "description": "Pre-renders dynamic EJS invoice template in HTML."
        },
        {
          "path": "/invoices/download/:id",
          "method": "GET",
          "authRequired": true,
          "description": "Compiles the EJS invoice into a PDF using PDFKit and prompts standard file download."
        },
        {
          "path": "/invoices/:id",
          "method": "GET",
          "authRequired": true,
          "description": "Get invoice detailed view, including items, totals, patient details, and payments.",
          "params": {
            "id": { "type": "string", "required": true }
          }
        },
        {
          "path": "/invoices/:id",
          "method": "PUT",
          "authRequired": true,
          "allowedRoles": ["ADMIN"],
          "contentType": "multipart/form-data",
          "description": "Update invoice metadata (PUT / PATCH). Can upload new file.",
          "params": {
            "id": { "type": "string", "required": true }
          },
          "body": {
            "dueDate": { "type": "string | Date", "required": false },
            "discountAmount": { "type": "number", "required": false },
            "taxAmount": { "type": "number", "required": false },
            "paidAmount": { "type": "number", "required": false },
            "status": { "type": "InvoiceStatus", "required": false },
            "pdfUrl": { "type": "string (url)", "required": false },
            "items": { "type": "array of objects", "required": false },
            "attachmentFile": { "type": "file", "required": false }
          }
        },
        {
          "path": "/invoices/:id",
          "method": "DELETE",
          "authRequired": true,
          "allowedRoles": ["ADMIN"],
          "description": "Soft delete invoice.",
          "params": {
            "id": { "type": "string", "required": true }
          }
        }
      ]
    },
    "notifications": {
      "description": "User in-app notifications and alerts.",
      "routes": [
        {
          "path": "/notifications",
