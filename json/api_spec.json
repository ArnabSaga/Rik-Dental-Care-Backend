            "id": { "type": "string", "required": true }
          }
        },
        {
          "path": "/notifications/:id/read",
          "method": "PATCH",
          "authRequired": true,
          "description": "Mark a single notification as read.",
          "params": {
            "id": { "type": "string", "required": true }
          }
        },
        {
          "path": "/notifications/:id",
          "method": "DELETE",
          "authRequired": true,
          "description": "Remove/delete notification.",
          "params": {
            "id": { "type": "string", "required": true }
          }
        }
      ]
    },
    "chat": {
      "description": "Instant messaging, support channels, and AI Dental assistant.",
      "routes": [
        {
          "path": "/chat/conversations",
          "method": "GET",
          "authRequired": true,
          "description": "Get user conversations list.",
          "query": {
            "searchTerm": { "type": "string", "required": false },
            "patientId": { "type": "string", "required": false },
            "type": { "type": "ConversationType", "required": false },
            "page": { "type": "number | string", "required": false },
            "limit": { "type": "number | string", "required": false }
          }
        },
        {
          "path": "/chat/conversations",
          "method": "POST",
          "authRequired": true,
          "description": "Create a new conversation channel.",
          "body": {
            "title": { "type": "string", "required": false, "max": 150, "nullable": true },
            "type": { "type": "ConversationType", "required": false, "default": "PATIENT_SUPPORT" },
            "patientId": { "type": "string", "required": false }
          }
        },
        {
          "path": "/chat/conversations/:id",
          "method": "GET",
          "authRequired": true,
          "description": "Get specific conversation details.",
          "params": {
            "id": { "type": "string", "required": true }
          }
        },
        {
          "path": "/chat/conversations/:id",
          "method": "DELETE",
          "authRequired": true,
          "description": "Delete a conversation channel.",
          "params": {
            "id": { "type": "string", "required": true }
          }
        },
        {
          "path": "/chat/conversations/:id/messages",
          "method": "GET",
          "authRequired": true,
          "description": "Retrieve messages within a specific conversation channel. Filterable & paginated.",
          "params": {
            "id": { "type": "string", "required": true }
          },
          "query": {
            "searchTerm": { "type": "string", "required": false },
