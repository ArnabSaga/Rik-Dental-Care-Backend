<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= title %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        /* Standard reset and base styles */
        body {
            margin: 0;
            padding: 0;
            background-color: #f1f5f9;
            /* Slate 100 */
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            color: #0f172a;
            /* Slate 900 */
            -webkit-font-smoothing: antialiased;
        }

        .wrapper {
            width: 100%;
            padding: 40px 16px;
            background-color: #f1f5f9;
            box-sizing: border-box;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
            border-top: 6px solid #2563eb;
            /* Modern Blue Accent */
        }

        /* --- Header --- */
        .header {
            padding: 40px 40px 24px;
            background-color: #ffffff;
            border-bottom: 1px solid #f1f5f9;
        }

        .clinic-name {
            margin: 0;
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.02em;
            color: #0f172a;
        }

        .clinic-subtitle {
            margin: 4px 0 0;
            font-size: 14px;
            color: #64748b;
            /* Slate 500 */
            font-weight: 500;
        }

        /* --- Content --- */
        .content {
            padding: 32px 40px;
        }

        .greeting {
            margin: 0 0 24px;
            font-size: 16px;
            color: #334155;
            /* Slate 700 */
            line-height: 1.5;
        }

        .greeting strong {
            color: #0f172a;
            font-weight: 700;
        }

        .notification-card {
            border: 1px solid #e2e8f0;
            /* Slate 200 */
            border-radius: 12px;
            padding: 24px;
            background-color: #f8fafc;
            /* Slate 50 */
            margin: 0 0 32px;
        }

        .notification-type {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            background-color: #eff6ff;
            /* Blue 50 */
            color: #2563eb;
            /* Blue 600 */
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 16px;
        }

        .title {
            margin: 0 0 12px;
            font-size: 18px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.01em;
        }

        .message {
            margin: 0;
            font-size: 15px;
            line-height: 1.6;
            color: #475569;
            /* Slate 600 */
        }

        .meta {
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px dashed #cbd5e1;
            /* Slate 300 */
            font-size: 14px;
            color: #64748b;
        }

        .meta div {
            margin-bottom: 4px;
        }

        .meta div:last-child {
            margin-bottom: 0;
        }

        .meta strong {
            color: #334155;
            font-weight: 600;
            margin-right: 4px;
        }

        /* --- Action Button --- */
        .button-wrapper {
            margin: 32px 0;
        }

        .button {
            display: inline-block;
            padding: 14px 28px;
            border-radius: 8px;
            background-color: #2563eb;
            color: #ffffff !important;
            text-decoration: none;
            font-weight: 600;
            font-size: 15px;
            text-align: center;
            transition: background-color 0.2s ease;
        }

        .button:hover {
            background-color: #1d4ed8;
        }

        /* --- Note --- */
        .note {
            margin-top: 32px;
            padding: 16px 20px;
            border-radius: 8px;
            background-color: #eff6ff;
            border-left: 4px solid #2563eb;
            color: #1e3a8a;
            /* Blue 900 */
            font-size: 13px;
            line-height: 1.6;
        }

        /* --- Footer --- */
        .footer {
            padding: 24px 40px;
            background-color: #f8fafc;
            border-top: 1px solid #e2e8f0;
            text-align: center;
            color: #64748b;
            font-size: 13px;
            line-height: 1.6;
        }

        @media only screen and (max-width: 600px) {
            .wrapper {
                padding: 20px 12px;
            }

            .header,
            .content,
            .footer {
                padding: 24px 20px;
            }

            .title {
                font-size: 17px;
            }

            .notification-card {
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <div class="container">
            <div class="header">
                <h1 class="clinic-name">Rik Dental Care Center</h1>
                <p class="clinic-subtitle">Modern Dental Care & Patient Service</p>
            </div>

            <div class="content">
                <p class="greeting">
                    Dear <strong>
                        <%= recipientName || "Patient" %>
                    </strong>,
                </p>

                <div class="notification-card">
                    <div class="notification-type">
                        <%= type || "SYSTEM" %>
                    </div>

                    <h2 class="title">
                        <%= title %>
                    </h2>

                    <p class="message">
                        <%= message %>
                    </p>

                    <% if (entityType || entityId) { %>
                        <div class="meta">
                            <% if (entityType) { %>
                                <div><strong>Related To:</strong>
                                    <%= entityType %>
                                </div>
                                <% } %>

                                    <% if (entityId) { %>
                                        <div><strong>Reference ID:</strong>
                                            <%= entityId %>
                                        </div>
                                        <% } %>
                        </div>
                        <% } %>
                </div>

                <% if (actionUrl) { %>
                    <div class="button-wrapper">
                        <a href="<%= actionUrl %>" class="button">View Details</a>
                    </div>
                    <% } %>

                        <div class="note">
                            <strong>Automated Message</strong><br />
                            This notification was generated by Rik Dental Care Center. Please contact the clinic
                            directly if you require any clarification.
                        </div>
            </div>

            <div class="footer">
                © <%= new Date().getFullYear() %> Rik Dental Care Center.<br />
                    Thank you for trusting us with your dental care.
            </div>
        </div>
    </div>
</body>

</html>
