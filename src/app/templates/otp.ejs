<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= appName %> — OTP
  </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #f1f5f9;
      /* Slate 100 */
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #0f172a;
      /* Slate 900 */
      -webkit-font-smoothing: antialiased;
    }

    .wrapper {
      width: 100%;
      padding: 40px 16px;
      box-sizing: border-box;
      background-color: #f1f5f9;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
      border-top: 6px solid #2563eb;
      /* Modern Blue Accent */
    }

    /* --- Header --- */
    .header {
      padding: 40px 40px 24px;
      text-align: center;
      background-color: #ffffff;
      border-bottom: 1px solid #f8fafc;
    }

    .header h1 {
      margin: 0;
      color: #0f172a;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }

    .header p {
      margin: 6px 0 0;
      color: #64748b;
      /* Slate 500 */
      font-size: 14px;
      font-weight: 500;
    }

    /* --- Content --- */
    .body {
      padding: 32px 40px;
    }

    .greeting {
      margin: 0 0 20px;
      font-size: 16px;
      color: #334155;
      /* Slate 700 */
    }

    .greeting strong {
      color: #0f172a;
      font-weight: 700;
    }

    .message {
      margin: 0 0 32px;
      font-size: 15px;
      line-height: 1.6;
      color: #475569;
      /* Slate 600 */
    }

    /* --- OTP Display --- */
    .otp-wrapper {
      text-align: center;
      margin-bottom: 32px;
    }

    .otp-box {
      display: inline-block;
      background-color: #f8fafc;
      /* Slate 50 */
      border: 1px solid #e2e8f0;
      /* Slate 200 */
      border-radius: 12px;
      padding: 24px 48px;
    }

    .otp-label {
      font-size: 12px;
      color: #64748b;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .otp-code {
      font-size: 42px;
      font-weight: 800;
      color: #2563eb;
      letter-spacing: 12px;
      margin-right: -12px;
      /* Compensates for the last letter's spacing to keep it visually centered */
    }

    .expiry {
      display: inline-block;
      padding: 8px 16px;
      background-color: #fff1f2;
      /* Rose 50 */
      color: #e11d48;
      /* Rose 600 */
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
    }

    /* --- Footer & Extras --- */
    .divider {
      border: none;
      border-top: 1px dashed #cbd5e1;
      /* Slate 300 */
      margin: 32px 0;
    }

    .warning {
      font-size: 13px;
      color: #64748b;
      line-height: 1.6;
      margin: 0;
    }

    .footer {
      padding: 24px 40px;
      background-color: #f8fafc;
      border-top: 1px solid #e2e8f0;
      text-align: center;
    }

    .footer p {
      margin: 0;
      font-size: 13px;
      color: #64748b;
      line-height: 1.6;
    }

    .footer strong {
      color: #0f172a;
      font-weight: 600;
    }

    /* --- Mobile Adjustments --- */
    @media only screen and (max-width: 600px) {
      .wrapper {
        padding: 20px 12px;
      }

      .header,
      .body,
      .footer {
        padding: 24px 20px;
      }

      .otp-box {
        padding: 20px 32px;
        width: 100%;
        box-sizing: border-box;
      }

      .otp-code {
        font-size: 36px;
        letter-spacing: 10px;
        margin-right: -10px;
      }
    }
  </style>
</head>

<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <h1>🦷 <%= appName %>
        </h1>
        <p>Your trusted dental care partner</p>
      </div>

      <div class="body">
        <p class="greeting">Hello, <strong>
            <%= name %>
          </strong>!</p>

        <p class="message">
          We received a request associated with your account. Use the one-time password (OTP) below to complete your
          action. Please do not share this code with anyone.
        </p>

        <div class="otp-wrapper">
          <div class="otp-box">
            <div class="otp-label">Your Verification Code</div>
            <div class="otp-code">
              <%= otp %>
            </div>
          </div>

          <div style="margin-top: 20px;">
            <div class="expiry">
              ⏱ Expires in <%= expiryMinutes %> minute<%= expiryMinutes !==1 ? 's' : '' %>
            </div>
          </div>
        </div>

        <hr class="divider" />

        <p class="warning">
          If you did not request this code, you can safely ignore this email. For any concerns, please contact our
          support team immediately.
        </p>
      </div>

      <div class="footer">
        <p>© <%= new Date().getFullYear() %> <strong>
              <%= appName %>
            </strong>. All rights reserved.</p>
        <p style="margin-top: 6px;">This is an automated email, please do not reply.</p>
      </div>
    </div>
  </div>
</body>

</html>
