model User {
  id                    String               @id
  name                  String
  email                 String               @unique
  emailVerified         Boolean              @default(false)
  role                  Role                 @default(PATIENT)
  status                Status               @default(ACTIVE)
  image                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  phone                 String?
  isActive              Boolean              @default(true)
  isDeleted             Boolean              @default(false)
  deletedAt             DateTime?
  accounts              Account[]
  createdAppointments   Appointment[]        @relation("CreatedAppointments")
  appointmentsAsPatient Appointment[]        @relation("PatientAppointments")
  appointmentsAsDoctor  Appointment[]        @relation("TreatedAppointments")
  receivedMessages      ChatMessage[]        @relation("MessageRecipient")
  sentMessages          ChatMessage[]        @relation("MessageSender")
  createdClinicalNotes  ClinicalNote[]       @relation("CreatedClinicalNotes")
  updatedClinicalNotes  ClinicalNote[]       @relation("UpdatedClinicalNotes")
  patientConversations  Conversation[]       @relation("PatientConversations")
  doctorAvailabilities  DoctorAvailability[] @relation("DoctorAvailabilities")
  doctorProfile         DoctorProfile?
  issuedInvoices        Invoice[]            @relation("IssuedBy")
  managerProfile        ManagerProfile?
  notifications         Notification[]
  patientProfile        PatientProfile?
  receivedPayments      Payment[]            @relation("ReceivedBy")
  createdPrescriptions  Prescription[]       @relation("CreatedPrescriptions")
  updatedPrescriptions  Prescription[]       @relation("UpdatedPrescriptions")
  sessions              Session[]
  createdTreatmentPlans TreatmentPlan[]      @relation("CreatedTreatmentPlans")
  updatedTreatmentPlans TreatmentPlan[]      @relation("UpdatedTreatmentPlans")

  @@index([role])
  @@index([status])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
