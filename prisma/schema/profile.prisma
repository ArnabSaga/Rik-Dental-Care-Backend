model PatientProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  address          String?
  emergencyContact String?
  dateOfBirth      DateTime?
  gender           Gender?
  bloodGroup       BloodGroup?
  allergy          String?
  medicalCondition String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  isDeleted        Boolean          @default(false)
  medicalHistory   MedicalHistory[]
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([gender])
  @@index([bloodGroup])
  @@index([isDeleted])
  @@map("patient_profile")
}

model ManagerProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  designation String?
  phone       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isDeleted   Boolean   @default(false)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDeleted])
  @@map("manager_profile")
}

model DoctorProfile {
  id           String    @id @default(uuid())
  userId       String    @unique
  bmdcNumber   String?
  specialty    String?
  designation  String?
  bio          String?
  signatureUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  isDeleted    Boolean   @default(false)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDeleted])
  @@map("doctor_profile")
}
