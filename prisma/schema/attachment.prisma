model Attachment {
  id               String          @id @default(uuid())
  url              String
  publicId         String?
  fileType         AttachmentType  @default(IMAGE)
  resourceType     String?
  appointmentId    String?
  medicalHistoryId String?
  clinicalNoteId   String?
  prescriptionId   String?
  invoiceId        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  isDeleted        Boolean         @default(false)
  appointment      Appointment?    @relation(fields: [appointmentId], references: [id])
  clinicalNote     ClinicalNote?   @relation(fields: [clinicalNoteId], references: [id])
  invoice          Invoice?        @relation(fields: [invoiceId], references: [id])
  medicalHistory   MedicalHistory? @relation(fields: [medicalHistoryId], references: [id])
  prescription     Prescription?   @relation(fields: [prescriptionId], references: [id])

  @@index([appointmentId])
  @@index([medicalHistoryId])
  @@index([clinicalNoteId])
  @@index([prescriptionId])
  @@index([invoiceId])
  @@map("attachment")
}
