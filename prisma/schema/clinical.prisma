model MedicalHistory {
  id               String             @id @default(uuid())
  description      String
  date             DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  isDeleted        Boolean            @default(false)
  allergy          String?
  condition        String?
  medication       String?
  title            String?
  type             MedicalHistoryType @default(OTHER)
  patientProfileId String
  attachments      Attachment[]
  patientProfile   PatientProfile     @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@index([patientProfileId])
  @@map("medical_history")
}

model ClinicalNote {
  id            String       @id @default(uuid())
  appointmentId String
  notes         String
  createdById   String
  updatedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  isDeleted     Boolean      @default(false)
  attachments   Attachment[]
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdBy     User         @relation("CreatedClinicalNotes", fields: [createdById], references: [id])
  updatedBy     User?        @relation("UpdatedClinicalNotes", fields: [updatedById], references: [id])

  @@index([appointmentId])
  @@map("clinical_note")
}

model TreatmentPlan {
  id            String      @id @default(uuid())
  appointmentId String
  description   String
  status        Status      @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  isDeleted     Boolean     @default(false)
  createdById   String
  updatedById   String?
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdBy     User        @relation("CreatedTreatmentPlans", fields: [createdById], references: [id])
  updatedBy     User?       @relation("UpdatedTreatmentPlans", fields: [updatedById], references: [id])

  @@index([appointmentId])
  @@map("treatment_plan")
}

model Prescription {
  id            String             @id @default(uuid())
  appointmentId String
  notes         String?
  pdfUrl        String?
  createdById   String
  updatedById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  isDeleted     Boolean            @default(false)
  attachments   Attachment[]
  appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  createdBy     User               @relation("CreatedPrescriptions", fields: [createdById], references: [id])
  updatedBy     User?              @relation("UpdatedPrescriptions", fields: [updatedById], references: [id])
  items         PrescriptionItem[]

  @@index([appointmentId])
  @@map("prescription")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  instructions   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_item")
}
